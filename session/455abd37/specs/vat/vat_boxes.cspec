# The boxes (rutor) of the Swedish VAT return (momsdeklaration)
#
# box.<NN>.element  eSKD 6.0 XML element name
# box.<NN>.title    box text on the form (Swedish)
# box.<NN>.kind     base (an amount the VAT is computed from, or a statistical value)
#                   | output_vat | input_vat | result
# box.<NN>.section  section letter on the form

spec.id = vat.boxes
spec.kind = mapping
spec.version = 1
spec.status = checked
spec.title = VAT return boxes and their eSKD element names
spec.derived_by = hand
spec.source.01.title = Skatteverket: Lämna momsdeklaration via fil (eSKDUpload 6.0, examples 1-6)
spec.source.01.url = https://www.skatteverket.se/foretag/moms/deklareramoms/skapaochskickainmomsdeklarationviafil.4.2fb39afe18dabf1e4d223cc.html
spec.source.01.local = testdata/skv_example_6.eskd
spec.source.02.title = Skatteverket: VAT items box by box (English)
spec.source.02.url = https://www.skatteverket.se/servicelankar/otherlanguages/inenglish/businessesandemployers/startingandrunningaswedishbusiness/declaringtaxesbusinesses/vat/vatitemsboxbybox.4.3dfca4f410f4fc63c8680004502.html
spec.note = Element names are checked against SKV example 6. Titles are written from notes and still need checking (status unverified)

