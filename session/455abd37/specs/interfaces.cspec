interface.journal_to_k2.status = planned
interface.journal_to_k2.milestone = M5

interface.journal_to_sru.title = Account balances to INK2 SRU fields
interface.journal_to_sru.direction = internal
interface.journal_to_sru.counterpart = journal, ink2_sru
interface.journal_to_sru.format = BAS account ranges to SRU field codes (SIE #SRU or BAS table)
interface.journal_to_sru.spec = ink2/sru_files.cspec
interface.journal_to_sru.status = planned
