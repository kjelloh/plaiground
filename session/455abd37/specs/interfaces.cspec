# --------------------------------------------------- internal transformations

interface.sie_to_journal.title = SIE records to the in-memory journal (vouchers, postings, accounts)
interface.sie_to_journal.direction = internal
interface.sie_to_journal.counterpart = sie4_import
interface.sie_to_journal.format = Generic SIE records to domain types
interface.sie_to_journal.spec = sie/sie4.cspec
interface.sie_to_journal.code = src/sie/sie_to_journal.hpp, src/sie/sie_to_journal.cpp
interface.sie_to_journal.status = skeleton
interface.sie_to_journal.milestone = M1

interface.statement_to_events.title = Statement rows to financial events
interface.statement_to_events.direction = internal
interface.statement_to_events.counterpart = bank_statement_import, skv_account_statement_import
