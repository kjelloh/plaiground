# cratchit interface registry
#
# Every way data enters, leaves or is transformed inside cratchit is listed here.
# Human-readable view: docs/interfaces.md
#
# Per interface:
#   title       one line
#   direction   in | out | internal
#   counterpart who or what is on the other side
#   format      the external format
#   spec        comma-separated spec files (relative to specs/) that pin the interface down
#   code        comma-separated source files (relative to the session root) that implement it
#   status      skeleton (code exists, partly done) | planned (near term) | future | listed (named only)
#   milestone   M1 = VAT return, M2 = SIE round trip, M3 = statements to vouchers,
#               M4 = Bokslut, M5 = Årsredovisning, M6 = INK2, M7+ = later
#   legal       comma-separated requirement ids from legal/requirements.cspec
#
# tests/specs_test.cpp checks that every listed spec and code file exists,
# and that every legal id is defined.

spec.id = cratchit.interfaces
spec.kind = registry
spec.version = 1
spec.status = draft
spec.title = All interfaces of cratchit
spec.derived_by = hand

# ---------------------------------------------------------------- inbound

interface.sie4_import.title = Read books as SIE type 4 files (e.g. Fortnox export)
interface.sie4_import.direction = in
interface.sie4_import.counterpart = Bookkeeping software (Fortnox), accountant
interface.sie4_import.format = SIE 4 (4C), #FORMAT PC8 (CP437), CRLF
interface.sie4_import.spec = sie/sie4.cspec
interface.sie4_import.code = src/sie/sie_reader.hpp, src/sie/sie_reader.cpp, src/sie/cp437.hpp, src/sie/cp437.cpp
interface.sie4_import.status = skeleton
interface.sie4_import.milestone = M1
interface.sie4_import.legal = BFL-5-1, BFL-5-11

interface.bank_statement_import.title = Read bank account statements
interface.bank_statement_import.direction = in
interface.bank_statement_import.counterpart = Bank (Nordea)
interface.bank_statement_import.format = CSV exported from the internet bank
interface.bank_statement_import.spec = statements/nordea_csv.cspec
interface.bank_statement_import.code = src/statements/csv_statement_reader.hpp, src/statements/csv_statement_reader.cpp
interface.bank_statement_import.status = skeleton
interface.bank_statement_import.milestone = M3
interface.bank_statement_import.legal = BFL-5-2, BFL-5-6

interface.skv_account_statement_import.title = Read the tax account (skattekonto) statement
interface.skv_account_statement_import.direction = in
interface.skv_account_statement_import.counterpart = Skatteverket
interface.skv_account_statement_import.format = CSV from the e-service (later: Skattekonto API)
interface.skv_account_statement_import.spec = statements/skv_account_csv.cspec
interface.skv_account_statement_import.code = src/statements/csv_statement_reader.hpp, src/statements/csv_statement_reader.cpp
interface.skv_account_statement_import.status = skeleton
interface.skv_account_statement_import.milestone = M3
interface.skv_account_statement_import.legal = BFL-5-6

interface.financial_event_listing.title = Financial event listing (date, amount, heading) that seeds vouchers
interface.financial_event_listing.direction = in
interface.financial_event_listing.counterpart = User, statement imports, receipts and invoices
interface.financial_event_listing.format = cspec listing, one event per event.NNNN branch
interface.financial_event_listing.spec = events/financial_event.cspec
interface.financial_event_listing.code = src/core/financial_event.hpp, src/core/financial_event.cpp
interface.financial_event_listing.status = skeleton
interface.financial_event_listing.milestone = M3
interface.financial_event_listing.legal = BFL-5-6, BFL-5-7

interface.voucher_documents.title = Underlying documents for vouchers (receipts, invoices as PDF or image)
interface.voucher_documents.direction = in
interface.voucher_documents.counterpart = Suppliers, customers, mail, scanner
interface.voucher_documents.format = Files in the archive folder, referenced by content hash
interface.voucher_documents.status = listed
interface.voucher_documents.milestone = M3
interface.voucher_documents.legal = BFL-5-6, BFL-5-7, BFL-7-1, BFL-7-2

interface.bas_chart_of_accounts.title = BAS chart of accounts as reference data
interface.bas_chart_of_accounts.direction = in
interface.bas_chart_of_accounts.counterpart = BAS-kontogruppen (bas.se)
interface.bas_chart_of_accounts.format = Free xlsx download, converted once to cspec. Names also come from SIE #KONTO
interface.bas_chart_of_accounts.spec = bas/account_types.cspec
interface.bas_chart_of_accounts.code = src/core/account_types.hpp, src/core/account_types.cpp
interface.bas_chart_of_accounts.status = skeleton
interface.bas_chart_of_accounts.milestone = M2

interface.bas_sru_mapping.title = BAS account to SRU field code mapping for INK2
interface.bas_sru_mapping.direction = in
interface.bas_sru_mapping.counterpart = BAS-kontogruppen (bas.se/kontoplaner/sru)
interface.bas_sru_mapping.format = Free xlsx/pdf "INK2 P1 intervall", converted to cspec
interface.bas_sru_mapping.status = planned
interface.bas_sru_mapping.milestone = M6

interface.skv_sru_field_definitions.title = SKV field definitions for SRU forms (INK2R, INK2S, …)
interface.skv_sru_field_definitions.direction = in
interface.skv_sru_field_definitions.counterpart = Skatteverket (SKV 269)
interface.skv_sru_field_definitions.format = xls per form and year, converted to cspec
interface.skv_sru_field_definitions.status = planned
interface.skv_sru_field_definitions.milestone = M6

interface.settings.title = Company settings that the books do not hold
interface.settings.direction = in
interface.settings.counterpart = User
interface.settings.format = cspec file .cratchit/settings.cspec
interface.settings.spec = settings/settings.cspec
interface.settings.code = src/app/settings.hpp, src/app/settings.cpp
interface.settings.status = skeleton
interface.settings.milestone = M1

interface.user_cli.title = Command line for bookkeeping operations and reports
interface.user_cli.direction = in
interface.user_cli.counterpart = User
interface.user_cli.format = cratchit <command> [options]
interface.user_cli.code = src/main.cpp
interface.user_cli.status = skeleton
interface.user_cli.milestone = M1
interface.user_cli.legal = BFL-5-11

