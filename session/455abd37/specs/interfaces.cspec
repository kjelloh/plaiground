interface.employer_declaration.title = Employer declaration (arbetsgivardeklaration, AGI), including zero salary months
interface.employer_declaration.direction = out
interface.employer_declaration.counterpart = Skatteverket (file upload or API)
interface.employer_declaration.format = XML file per SKV specification, or API
interface.employer_declaration.status = listed
