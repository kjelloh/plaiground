interface.journal_to_vat_boxes.code = src/vat/vat_calculation.hpp, src/vat/vat_calculation.cpp, src/vat/vat_spec.hpp, src/vat/vat_spec.cpp
interface.journal_to_vat_boxes.status = skeleton
interface.journal_to_vat_boxes.milestone = M1
interface.journal_to_vat_boxes.legal = ML-VAT, SFL-26

interface.journal_to_k2.title = Account balances to annual report (K2) line items
interface.journal_to_k2.direction = internal
