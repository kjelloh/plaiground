interface.annual_report_ixbrl.status = planned
interface.annual_report_ixbrl.milestone = M5
interface.annual_report_ixbrl.legal = BFL-6-1, ARL-2-1, ARL-8-3

interface.ink2_sru.title = Corporate income tax return (INK2, INK2R, INK2S) as SRU files
